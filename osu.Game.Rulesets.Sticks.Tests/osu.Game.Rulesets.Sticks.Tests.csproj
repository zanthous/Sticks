<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(SticksTargetFramework)</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <RootNamespace>osu.Game.Rulesets.Sticks.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <!-- NUnit 4.6 requires C# 13 overload resolution; keep the .NET 8/C# 12 build supported. -->
    <PackageReference Include="NUnit" Version="4.5.1" Condition="'$(TargetFramework)' == 'net8.0'" />
    <PackageReference Include="NUnit" Version="4.6.1" Condition="'$(TargetFramework)' != 'net8.0'" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.2.0" />
    <ProjectReference Include="..\osu.Game.Rulesets.Sticks\osu.Game.Rulesets.Sticks.csproj" />
    <EmbeddedResource Include="..\Design\skin-example\Sticks Minimal.osk" LogicalName="osu.Game.Rulesets.Sticks.Tests.Resources.SticksMinimal.osk" />
  </ItemGroup>
</Project>
